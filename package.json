{
  "name": "nibbles",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:release": "tsx tools/verify-release.ts",
    "preview": "vite preview",
